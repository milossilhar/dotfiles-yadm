POSTGRES := './compose.yaml'
POSTGRES_PASSWORD := 'dugong'
#POSTGRES_PASSWORD := `grep POSTGRES_PASSWORD ~/.config/just/postgres/.env | sed 's/POSTGRES_PASSWORD=//' | sed 's/\"//g'`

# lists all recipes
@default:
  just --list

# inspects compose file
@inspect:
  cat {{POSTGRES}}

# creates a new database with given name
@create dbname:
  PGPASSWORD={{POSTGRES_PASSWORD}} psql -d postgres -h localhost -p 5432 -U postgres -c "CREATE DATABASE {{dbname}}"

# drops existing database with given name [asks before proceeding]
@drop dbname:
  ../yesno.sh && PGPASSWORD={{POSTGRES_PASSWORD}} psql -d postgres -h localhost -p 5432 -U postgres -c "DROP DATABASE {{dbname}}"

# recreates the database (drop, create) [asks before proceeding]
@recreate dbname:
  ../yesno.sh && \
  PGPASSWORD={{POSTGRES_PASSWORD}} psql -d postgres -h localhost -p 5432 -U postgres -c "DROP DATABASE {{dbname}}" && \
  PGPASSWORD={{POSTGRES_PASSWORD}} psql -d postgres -h localhost -p 5432 -U postgres -c "CREATE DATABASE {{dbname}}"

# lists all available databases
@list:
  PGPASSWORD={{POSTGRES_PASSWORD}} psql -l -h localhost -p 5432 -U postgres

# test restoring database from pg_dump file
[no-cd]
@restore db file format='c':
  PGPASSWORD={{POSTGRES_PASSWORD}} pg_restore -h localhost -p 5432 -U postgres --dbname={{db}} --format={{format}} {{file}}

# runs commands from file against chosen db
[no-cd]
@run db file:
  PGPASSWORD={{POSTGRES_PASSWORD}} psql --set ON_ERROR_STOP=1 -d {{db}} -h localhost -p 5432 -U postgres -f {{file}}

# connects to choosen db 
@connect db='postgres':
  PGPASSWORD={{POSTGRES_PASSWORD}} psql -d {{db}} -h localhost -p 5432 -U postgres

# start postgres service in docker
@start:
  sudo docker compose -f {{POSTGRES}} up -d

# stops postgres service in docker
@stop:
  sudo docker compose -f {{POSTGRES}} down

# removes postgres (inluding volume)
@remove:
  ../yesno.sh && sudo docker compose -f {{POSTGRES}} down -v || echo

# shows pass for local postgres database
@pass:
  echo {{POSTGRES_PASSWORD}}
