{
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode",
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go",
  },
  "[java]": {
    "editor.defaultFormatter": "redhat.java",
  },
  "[svg]": {
    "editor.defaultFormatter": "jock.svg",
  },
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.cursorBlinking": "solid",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.cursorSurroundingLines": 4,
  "editor.fontFamily": "JetBrains Mono",
  "editor.fontLigatures": false,
  "editor.fontSize": 14,
  "editor.formatOnSave": true,
  "editor.indentSize": "tabSize",
  "editor.lineNumbers": "relative",
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "none",
  "editor.tabCompletion": "on",
  "editor.tabSize": 2,
  "editor.wordWrapColumn": 160,
  "explorer.fileNesting.patterns": {
    "*.db": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.s3db": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.sqlite": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.ts": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
    "tsconfig.json": "tsconfig.*.json",
  },
  "files.associations": {
    ".justfile": "just",
    "dot-bash_aliases": "shellscript",
    "dot-bashrc": "shellscript",
    "dot-profile": "shellscript",
  },
  "git.openRepositoryInParentFolders": "never",
  "json.schemaDownload.enable": true,
  "prettier.resolveGlobalModules": true,
  "redhat.telemetry.enabled": false,
  "security.workspace.trust.untrustedFiles": "open",
  "svg.preview.mode": "svg",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.fontFamily": "DroidSansMono Nerd Font",
  "terminal.integrated.showExitAlert": false,
  "vim.handleKeys": {
    "<C-a>": false,
    "<C-c>": false,
    "<C-f>": false,
    "<C-p>": false,
    "<C-v>": false,
    "<C-w>": false,
    "<C-x>": false,
    "<C-y>": false,
    "<C-z>": false,
  },
  "vim.highlightedyank.color": "rgba(203, 166, 247, 0.8)",
  "vim.highlightedyank.duration": 300,
  "vim.highlightedyank.enable": true,
  "vim.highlightedyank.textColor": "rgb(17, 17, 27)",
  "vim.hlsearch": false,
  "vim.ignorecase": true,
  "vim.incsearch": true,
  "vim.insertModeKeyBindings": [
    {
      "before": ["<C-s>"],
      "commands": [":w"],
    },
  ],
  "vim.leader": "<space>",
  "vim.normalModeKeyBindings": [
    {
      "before": ["<S-h>"],
      "commands": ["workbench.action.previousEditor"],
    },
    {
      "before": ["<S-l>"],
      "commands": ["workbench.action.nextEditor"],
    },
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "after": ["<C-d>", "z", "z"],
      "before": ["<C-d>"],
    },
    {
      "after": ["<C-u>", "z", "z"],
      "before": ["<C-u>"],
    },
  ],
  "vim.visualModeKeyBindings": [
    {
      "before": [">"],
      "after": [">", "g", "v"],
    },
    {
      "before": ["<"],
      "after": ["<", "g", "v"],
    },
  ],
  "vim.smartcase": true,
  "vim.sneak": false,
  "vim.surround": true,
  "vim.useCtrlKeys": true,
  "vim.useSystemClipboard": true,
  "window.autoDetectColorScheme": false,
  "window.title": "${dirty}${activeEditorMedium}${separator}${rootName}${separator}${profileName}${separator}${appName}",
  "window.zoomLevel": 0.2,
  "workbench.editor.enablePreview": false,
  "workbench.editorAssociations": {
    "*.svg": "default",
  },
  "workbench.startupEditor": "none",
  "cursor.composer.showEmptyStateTips": false,
  "cursor.composer.conversationDensity": "compact-ungrouped",
  "update.mode": "none",
  "workbench.colorTheme": "Catppuccin Mocha",
  "cursor.composer.usageSummaryDisplay": "always",
}
